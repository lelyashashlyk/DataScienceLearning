        "def get_diff_ellipse(r, x_center, y_center, ax=1.0, ay=1.0, points=100):\n",
        "    theta = np.linspace(0, 2*np.pi, points)\n",
        "    x = r * np.cos(theta) * ax + x_center\n",
        "    y = r * np.sin(theta) * ay + y_center\n",
        "    return x, y"
      ],
      "metadata": {
